# Public site URL used by Astro canonical URLs and the sitemap.
SITE_URL=https://your-domain.example

# Easy Content is deliberately disabled by default.
# Use `npm run dev:content` to force-enable the local editor, or set this to
# true for `npm run dev` (restart after changing .env). `npm run build` always
# remains production-clean. With this flag, `npm run preview` starts a
# loopback-only authoring companion from source so edits and unsaved previews
# work locally; use `npm run preview:content` for the explicit command.
# Never enable a write-enabled editor in a production deployment.
EASY_CONTENT_MODE=false

# Optional Vercel CLI token for CI or local token-based deployment.
# Keep the real token in your shell, CI secret store, or an ignored .env.local.
# VERCEL_TOKEN=
