# Public site URL used by Astro canonical URLs and the sitemap.
SITE_URL=https://your-domain.example

# Easy Content is deliberately disabled by default.
# Use `npm run dev:content` to enable the local editor safely, or set this to
# true only for a local development server. Never enable it for production.
EASY_CONTENT_MODE=false

# Optional Vercel CLI token for CI or local token-based deployment.
# Keep the real token in your shell, CI secret store, or an ignored .env.local.
# VERCEL_TOKEN=
