---
import ArticleCard from './ArticleCard.astro';
import ProjectGrid from '../platform/ProjectGrid.astro';
import type { Article } from '../../utils/blog';
import { categoryPath, isProjectArticle, isProjectOverview } from '../../utils/blog';
import { t, categoryLabel, type Locale } from '../../utils/i18n';
interface Props { lang: Locale; articles: Article[]; activeCategory?: string[]; favoriteProjects?: any[]; }
const { lang, articles, activeCategory = [], favoriteProjects = [] } = Astro.props;
const projectArticles = articles.filter(isProjectArticle);
const allCategories = [...new Set(projectArticles.map(article => article.data.category))].sort();
const tags = [...new Set(projectArticles.flatMap(article => article.data.tags))].sort();
// The landing page is a project index. Child articles remain discoverable from
// their project overview and from full-text search, but do not appear here by default.
const shown = projectArticles.filter(isProjectOverview).filter(article => !activeCategory.length || [article.data.category, article.data.subcategory].filter(Boolean).join('/').startsWith(activeCategory.join('/')));
const featured = shown.find(article => article.data.featured);
---
<section class="mx-auto max-w-container px-6 py-14 md:py-20">
  <nav aria-label="Breadcrumb" class="mb-8 text-sm"><a href={`/${lang}/`}>{t('nav.start', lang)}</a>{activeCategory.length ? <> / <a href={`/${lang}/blog/`}>{t('nav.blog', lang)}</a>{activeCategory.map(part => <> / <span>{categoryLabel(part, lang)}</span></>)}</> : null}</nav>
  <div class="mb-12 max-w-3xl"><span class="text-sm font-semibold uppercase tracking-widest text-primary">{t('blog.sample', lang)}</span><h1 class="mt-3 font-heading text-h1">{activeCategory.length ? categoryLabel(activeCategory.at(-1)!, lang) : t('blog.title', lang)}</h1><p class="mt-4 text-lg text-secondary/70 dark:text-white/70">{t('blog.intro', lang)}</p>{!activeCategory.length && <div class="doc-content mt-8"><slot name="landing" /></div>}</div>
  {!activeCategory.length && favoriteProjects.length > 0 && <section class="mb-14" aria-labelledby="favorite-projects-title"><div class="mb-6 flex flex-wrap items-end justify-between gap-4"><div><span class="eyebrow">{t('blog.projectHubsLabel', lang)}</span><h2 id="favorite-projects-title" class="mt-2 font-heading text-h2">{t('blog.favoriteProjects', lang)}</h2></div><a class="font-medium text-primary hover:underline" href={`/${lang}/blog/projects/`}>{t('blog.viewProjects', lang)} →</a></div><ProjectGrid lang={lang} projects={favoriteProjects} limit={6} /></section>}
  {featured && !activeCategory.length && <div class="mb-12"><h2 class="mb-5 text-2xl font-semibold">{t('blog.featured', lang)}</h2><ArticleCard article={featured} /></div>}
  {shown.length > 0 && <><nav class="mb-8 flex flex-wrap gap-2" aria-label={t('blog.category', lang)}><a class="category-chip" href={`/${lang}/blog/`}>{t('blog.allCategories', lang)}</a>{allCategories.map(category => <a class="category-chip" href={categoryPath(lang, [category])}>{categoryLabel(category, lang)}</a>)}</nav>
  <div class="mb-8 grid gap-4 md:grid-cols-3">
    <label class="text-sm">{t('blog.search', lang)}<input id="article-search" type="search" placeholder={t('blog.searchHint', lang)} class="filter-input" /></label>
    <label class="text-sm">{t('blog.tag', lang)}<select id="tag-filter" class="filter-input"><option value="">{t('blog.allTags', lang)}</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></label>
    <label class="text-sm">{t('blog.sort', lang)}<select id="sort-filter" class="filter-input"><option value="newest">{t('blog.newest', lang)}</option><option value="oldest">{t('blog.oldest', lang)}</option></select></label>
  </div>
  <div id="search-results" class="hidden" aria-live="polite"></div>
  <div id="article-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{shown.map(article => <ArticleCard article={article} />)}</div>
  <p id="no-results" class="hidden py-10" aria-live="polite">{t('blog.noResults', lang)}</p>
  <div id="pagination" class="mt-8 flex flex-wrap gap-2" aria-label="Pagination"></div></>}
  {shown.length === 0 && <p class="empty-state">{lang === 'fa' ? 'هنوز مقاله‌ای منتشر نشده است. برای آغاز، یک MDX معتبر در content/blog/fa/ اضافه کنید.' : 'No articles have been published yet. Add a valid MDX file under content/blog/en/ to get started.'}</p>}
</section>
<script define:vars={{ lang }}>
  const input = document.querySelector('#article-search');
  const tag = document.querySelector('#tag-filter');
  const sort = document.querySelector('#sort-filter');
  const grid = document.querySelector('#article-grid');
  const pagination = document.querySelector('#pagination');
  const empty = document.querySelector('#no-results');
  const results = document.querySelector('#search-results');
  if (!input || !tag || !sort || !grid || !pagination || !empty || !results) {
    // Empty content directories intentionally render no interactive listing controls.
  } else {
  const cards = [...grid.querySelectorAll('.article-card')];
  let page = 1;
  let timer;
  async function update() {
    const query = input.value.trim();
    const chosen = tag.value;
    const order = sort.value;
    const filtered = cards.filter(card => (!chosen || card.dataset.tags.split('|').includes(chosen)) && (!query || card.dataset.search.includes(query.toLocaleLowerCase()))).sort((a,b) => order === 'oldest' ? a.dataset.date.localeCompare(b.dataset.date) : b.dataset.date.localeCompare(a.dataset.date));
    filtered.forEach(card => grid.append(card));
    const total = Math.ceil(filtered.length / 9);
    page = Math.min(page, Math.max(1,total));
    cards.forEach(card => card.hidden = !filtered.includes(card) || filtered.indexOf(card) < (page-1)*9 || filtered.indexOf(card) >= page*9);
    empty.classList.toggle('hidden', filtered.length > 0 || !!query);
    pagination.replaceChildren();
    for (let i=1;i<=total;i++) { const button=document.createElement('button'); button.type='button'; button.textContent=String(i); button.className='category-chip'; button.setAttribute('aria-current', String(i===page)); button.addEventListener('click',()=>{page=i;update();}); pagination.append(button); }
    results.replaceChildren(); results.classList.toggle('hidden', !query);
    if (query.length >= 2) {
      try {
        const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        const search = await pagefind.search(query, { filters: { locale: lang } });
        const hits = await Promise.all(search.results.slice(0,10).map(item => item.data()));
        for (const hit of hits.filter(hit => hit.url.includes(`/${lang}/blog/`))) { const a=document.createElement('a'); a.href=hit.url; a.className='search-hit'; a.textContent=hit.meta.title || hit.url; results.append(a); }
      } catch { /* local title and metadata filtering remains available during dev */ }
    }
  }
  input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{page=1;update();},250)});
  tag.addEventListener('change',()=>{page=1;update()});
  sort.addEventListener('change',()=>{page=1;update()});
  update();
  }
</script>
