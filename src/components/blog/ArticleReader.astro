---
import { render } from 'astro:content';
import type { Article } from '../../utils/blog';
import { published, articlePath, articleSegments, categoryPath, readingMinutes, formatDate } from '../../utils/blog';
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import Callout from './Callout.astro';
import Tabs from './Tabs.astro';
import Figure from './Figure.astro';
import AttachmentDownload from './AttachmentDownload.astro';
import MermaidDiagram from './MermaidDiagram.astro';
import MindMap from './MindMap.astro';
import CodeBlock from './CodeBlock.astro';
import { t, categoryLabel, type Locale } from '../../utils/i18n';
interface Props { article: Article; }
const { article } = Astro.props;
const lang = article.data.locale as Locale;
const all = await published();
const local = all.filter(item => item.data.locale === lang);
const index = local.findIndex(item => item.id === article.id);
const related = local.filter(item => item.id !== article.id && (item.data.category === article.data.category || item.data.tags.some(tag => article.data.tags.includes(tag)))).slice(0,3);
const translated = all.find(item => item.data.locale !== lang && item.data.translationId === article.data.translationId);
const alternates = { [lang]: articlePath(article), ...(translated ? { [translated.data.locale]: articlePath(translated) } : {}) };
const { Content, headings } = await render(article);
const parent = categoryPath(lang, articleSegments(article).slice(0,2));
const metadata = { '@context':'https://schema.org', '@type':'TechArticle', headline:article.data.title, description:article.data.description, inLanguage:lang, datePublished:article.data.pubDate.toISOString(), dateModified:(article.data.updatedDate || article.data.pubDate).toISOString() };
---
<Layout lang={lang} translationId={article.data.translationId} title={article.data.title} description={article.data.description} type="article" published={article.data.pubDate} updated={article.data.updatedDate} alternates={alternates} image={article.data.cover?.src}>
  <script type="application/ld+json" set:html={JSON.stringify(metadata)} />
  <div class="mx-auto max-w-container px-6 py-10 md:py-16">
    <nav class="mb-9 flex flex-wrap gap-2 text-sm" aria-label="Breadcrumb"><a href={`/${lang}/`}>{t('nav.start', lang)}</a><span>/</span><a href={`/${lang}/blog/`}>{t('nav.blog', lang)}</a>{articleSegments(article).map((segment, i) => <><span>/</span><a href={categoryPath(lang, articleSegments(article).slice(0,i+1))}>{categoryLabel(segment, lang)}</a></>)}</nav>
    <div class="reader-layout">
      <article class="min-w-0" data-pagefind-body data-pagefind-filter={`locale:${lang}`}>
        <header class="mb-10 border-b border-gray-200 pb-8 dark:border-gray-800"><span class="text-sm font-semibold text-primary">{t('blog.sample', lang)}</span><h1 class="mt-3 font-heading text-4xl leading-tight md:text-5xl">{article.data.title}</h1><p class="mt-5 text-lg text-secondary/70 dark:text-white/70">{article.data.description}</p><div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-secondary/60 dark:text-white/60">{article.data.author && <span>{article.data.author}</span>}<time datetime={article.data.pubDate.toISOString()}>{t('blog.published', lang)}: {formatDate(article.data.pubDate, lang)}</time>{article.data.updatedDate && <time datetime={article.data.updatedDate.toISOString()}>{t('blog.updated', lang)}: {formatDate(article.data.updatedDate, lang)}</time>}<span>{readingMinutes(article.body || '')} {t('blog.minutes', lang)}</span></div><div class="mt-5 flex flex-wrap gap-2">{article.data.tags.map(tag => <span class="tag">{tag}</span>)}</div><div class="mt-6 flex flex-wrap items-center gap-4"><LanguageSwitcher lang={lang} translationId={article.data.translationId} /><button type="button" id="copy-url" class="category-chip">{t('blog.share', lang)}</button></div></header>
        {article.data.toc && <details class="mobile-toc mb-8"><summary>{t('blog.toc', lang)}</summary><nav>{headings.filter(heading => heading.depth > 1).map(heading => <a href={`#${heading.slug}`} class="block py-1">{heading.text}</a>)}</nav></details>}
        <div class="doc-content"><Content components={{ Callout, Tabs, Figure, AttachmentDownload, MermaidDiagram, MindMap, CodeBlock }} /></div>
        <nav class="mt-12 grid gap-4 border-t pt-8 dark:border-gray-800 md:grid-cols-2"><a href={parent}>{t('blog.back', lang)}</a><div class="flex gap-4">{local[index-1] && <a href={articlePath(local[index-1])}>{t('blog.previous', lang)}: {local[index-1].data.title}</a>}{local[index+1] && <a href={articlePath(local[index+1])}>{t('blog.next', lang)}: {local[index+1].data.title}</a>}</div></nav>
        {related.length > 0 && <section class="mt-10"><h2 class="text-2xl font-semibold">{t('blog.related', lang)}</h2><ul class="mt-4 space-y-2">{related.map(item => <li><a href={articlePath(item)}>{item.data.title}</a></li>)}</ul></section>}
      </article>
      {article.data.toc && <aside class="desktop-toc"><h2 class="mb-4 font-semibold">{t('blog.toc', lang)}</h2><nav aria-label={t('blog.toc', lang)}>{headings.filter(heading => heading.depth > 1).map(heading => <a href={`#${heading.slug}`} class:list={['toc-link', `toc-depth-${heading.depth}`]}>{heading.text}</a>)}</nav></aside>}
    </div>
  </div>
</Layout>
<script define:vars={{ copied: t('blog.copied', lang) }}>
  document.querySelector('#copy-url')?.addEventListener('click', async event => { await navigator.clipboard.writeText(location.href); event.currentTarget.textContent = copied; });
  document.querySelectorAll('.doc-content pre').forEach(pre => { if (pre.closest('.diagram')) return; const button=document.createElement('button'); button.type='button'; button.className='copy-code'; button.textContent='Copy'; button.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.innerText);button.textContent='Copied';setTimeout(()=>button.textContent='Copy',1800)}); const wrapper=document.createElement('div'); wrapper.className='code-wrapper'; pre.before(wrapper); wrapper.append(pre,button); });
  const links=[...document.querySelectorAll('.toc-link')];
  const targets=links.map(link=>document.getElementById(link.getAttribute('href').slice(1))).filter(Boolean);
  const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){links.forEach(link=>link.classList.toggle('active',link.getAttribute('href')==='#'+entry.target.id))}})},{rootMargin:'-100px 0px -70% 0px'});
  targets.forEach(target=>observer.observe(target));
</script>
