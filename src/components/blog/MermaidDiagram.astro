---
interface Props { chart: string; label?: string; }
const { chart, label = 'Diagram' } = Astro.props;
---
<figure class="diagram mermaid-diagram" data-mermaid data-chart={chart}>
  <div class="diagram-toolbar"><span>{label}</span><button type="button" data-enlarge aria-label={`Enlarge ${label}`}>⛶</button></div>
  <div class="diagram-stage" role="img" aria-label={label}><p class="diagram-status">Rendering diagram…</p></div>
  <figcaption>{label}</figcaption>
</figure>
<script>
  import { observeMermaidDiagrams } from './mermaid-renderer.js';
  observeMermaidDiagrams(document);
</script>
