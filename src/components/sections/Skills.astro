---
import type { Locale } from '../../utils/i18n';
import { localizedValue, portfolio, publicItems } from '../../utils/portfolio-content';
import { categoryIcons, technologyIcon } from '../../utils/skill-icons';
import EmptyState from '../platform/EmptyState.astro';
const lang = Astro.currentLocale as Locale;
const entries: any[] = publicItems(portfolio().skills as any[]);
---
<section id="skills" class="tracked-section skills-section py-16 md:py-24">
  <div class="mx-auto max-w-container px-6">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-h2">{lang === 'fa' ? 'مهارت‌های اصلی' : 'Core skills'}</h2>
      <p class="mt-3 text-secondary/70 dark:text-white/70">{lang === 'fa' ? 'دسته‌بندی‌شده بر اساس زمینه‌های قابل توضیح در پروژه و گفت‌وگوی فنی.' : 'Grouped by areas that can be explained through projects and technical conversations.'}</p>
    </div>
    {entries.length ? <div class="skill-clusters-grid">{entries.map((entry: any, index: number) => { const copy = localizedValue(entry.locales, lang); const Icon = categoryIcons[entry.category]; return <article class="skill-cluster skill-card" data-aos="fade-up" data-aos-delay={index * 100}><div class="skill-card-heading"><div class="skill-category-icon"><Icon size={26} strokeWidth={1.75} /></div><h3>{copy.title}</h3></div><p class="skill-card-description">{copy.description || copy.summary}</p><div class="cluster-tools">{entry.technologies.map((technology: string) => { const Tool = technologyIcon(technology); return <div class="tool-item"><div class="tool-icon"><Tool size={21} strokeWidth={1.75} aria-hidden="true" /></div><p>{technology}</p></div>; })}</div></article>; })}</div> : <EmptyState title={lang === 'fa' ? 'مهارت‌ها' : 'Skills'} description={lang === 'fa' ? 'مهارت‌های خود را به content/skills/entries.json اضافه کنید.' : 'Add your skills to content/skills/entries.json.'} />}
  </div>
</section>
