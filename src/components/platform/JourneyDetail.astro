---
import type { Locale } from '../../utils/i18n';
import { formatDate } from '../../utils/blog';
import { localizedValue, portfolio } from '../../utils/portfolio-content';
import EmptyState from './EmptyState.astro';
const { id, lang } = Astro.props as { id: string; lang: Locale };
const item: any = portfolio().journey.find((entry: any) => entry.id === id && (entry.visible || import.meta.env.DEV));
const copy = item ? localizedValue(item.locales, lang) : undefined;
---
{item && copy ? <article class="container mx-auto max-w-3xl px-4 py-16" dir={lang === 'fa' ? 'rtl' : 'ltr'}>
  <a class="text-primary" href={`/${lang}/journey/`}>← {lang === 'fa' ? 'بازگشت به مسیر' : 'Back to journey'}</a>
  <header class="mt-8 border-b border-slate-200 pb-8 dark:border-slate-700">
    {item.startDate && <time class="text-sm text-slate-500">{formatDate(item.startDate, lang)}{item.current ? ` — ${lang === 'fa' ? 'اکنون' : 'Present'}` : item.endDate ? ` — ${formatDate(item.endDate, lang)}` : ''}</time>}
    <h1 class="mt-3 text-4xl font-bold">{copy.title}</h1>
    {item.organization && <p class="mt-3 text-primary">{item.organization}</p>}
    {item.location && <p class="mt-2 text-slate-500">{item.location}</p>}
  </header>
  <p class="mt-8 text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.description}</p>
  {item.technologies?.length > 0 && <div class="mt-8 flex flex-wrap gap-2">{item.technologies.map((technology: string) => <span class="tag">{technology}</span>)}</div>}
</article> : <div class="container mx-auto max-w-3xl px-4 py-16"><EmptyState title={lang === 'fa' ? 'رویداد پیدا نشد' : 'Journey event not found'} description={lang === 'fa' ? 'این رویداد در دسترس نیست.' : 'This journey event is not available.'} /></div>}
