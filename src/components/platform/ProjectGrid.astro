---
import type { Locale } from '../../utils/i18n';
import { localizedValue, publicItems, portfolio } from '../../utils/portfolio-content';
import { articlePath, published } from '../../utils/blog';
import EmptyState from './EmptyState.astro';
const lang = Astro.props.lang as Locale;
const projects: any[] = publicItems(portfolio().projects as any[]).filter((project: any) => project.featured);
const articles = await published(lang);
const maturityLabel = (maturity: string) => ({
  organizational: lang === 'fa' ? 'فعالیت سازمانی' : 'Organizational initiative',
  'internal-pilot': lang === 'fa' ? 'پایلوت داخلی' : 'Internal pilot',
  'academic-mvp': lang === 'fa' ? 'نمونهٔ آموزشی' : 'Educational MVP',
  'experimental-open-source': lang === 'fa' ? 'آزمایشی / متن‌باز' : 'Experimental / open source',
}[maturity] || maturity);
---
{projects.length ? <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{projects.map((project: any) => { const copy = localizedValue(project.locales, lang); const projectArticles = articles.filter(article => article.data.category === 'projects' && article.data.subcategory === project.id); return <article class="article-card p-6">{project.image && <img src={project.image} alt="" loading="lazy" />}<div class="mb-3 flex flex-wrap items-center gap-2"><span class="tag">{maturityLabel(project.maturity)}</span>{project.featured && <span class="text-xs uppercase tracking-wide text-primary">{lang === 'fa' ? 'منتخب' : 'Featured'}</span>}</div><h2 class="text-xl font-semibold">{copy.title}</h2><p class="mt-3 text-secondary/70 dark:text-white/70">{copy.description || copy.summary}</p><div class="mt-4 flex flex-wrap gap-2">{project.technologies.map((technology: string) => <span class="tag">{technology}</span>)}</div><div class="mt-5 flex flex-wrap gap-4">{project.repository && <a href={project.repository} rel="noopener noreferrer" target="_blank">GitHub</a>}{project.externalUrl && <a href={project.externalUrl} rel="noopener noreferrer" target="_blank">{lang === 'fa' ? 'مشاهده' : 'View'}</a>}</div>{projectArticles.length > 0 && <nav class="mt-5 border-t pt-4" aria-label={lang === 'fa' ? 'مقاله‌های پروژه' : 'Project articles'}><ul class="space-y-2">{projectArticles.map(article => <li><a href={articlePath(article)}>{article.data.title}</a></li>)}</ul></nav>}</article> })}</div> : <EmptyState title={lang === 'fa' ? 'پروژه‌ها' : 'Projects'} description={lang === 'fa' ? 'با افزودن مطالعات موردی به content/projects/entries.json، پروژه‌ها اینجا نمایش داده می‌شوند.' : 'Add case studies to content/projects/entries.json to display projects here.'} />}
