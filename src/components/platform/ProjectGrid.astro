---
import type { Locale } from '../../utils/i18n';
import { homepageProjects, publishedProjects, projectUrl, localizedValue, publicMediaPath } from '../../utils/content-api';
import { technologyIcon } from '../../utils/skill-icons';
import EmptyState from './EmptyState.astro';
import ProjectVisual from './ProjectVisual.astro';

interface Props { lang: Locale; featuredOnly?: boolean; showFilters?: boolean; projects?: any[]; limit?: number; }
const { lang, featuredOnly = false, showFilters = false, projects: providedProjects, limit = 6 } = Astro.props;
const all = providedProjects || (featuredOnly ? homepageProjects(limit) : publishedProjects());
const projects = all.slice(0, featuredOnly ? limit : all.length);
const categories: Record<string, { en: string; fa: string }> = {
  'devops-delivery': { en: 'DevOps & Delivery', fa: 'DevOps و تحویل' },
  'infrastructure-automation': { en: 'Infrastructure & Automation', fa: 'زیرساخت و خودکارسازی' },
  'networking-security': { en: 'Networking & Security', fa: 'شبکه و امنیت' },
  'software-open-source': { en: 'Software & Open Source', fa: 'نرم‌افزار و متن‌باز' },
  'design-creative': { en: 'Design & Creative', fa: 'طراحی و خلاقیت' },
};
const maturity: Record<string, { en: string; fa: string }> = {
  organizational: { en: 'Implemented initiative', fa: 'پیاده‌سازی سازمانی' },
  'internal-pilot': { en: 'Internal pilot', fa: 'پایلوت داخلی' },
  'internal-utility': { en: 'Internal utility', fa: 'ابزار داخلی' },
  'academic-mvp': { en: 'Educational MVP', fa: 'نمونهٔ آموزشی' },
  'sample-repository': { en: 'Public sample', fa: 'نمونهٔ عمومی' },
};
const label = (map: Record<string, { en: string; fa: string }>, key: string) => map[key]?.[lang] || key;
const usedCategories = Object.keys(categories).filter(category => projects.some((project: any) => project.category === category || project.secondaryCategories?.includes(category)));
---

{showFilters && projects.length > 0 && (
  <div class="project-filters" role="group" aria-label={lang === 'fa' ? 'فیلتر دسته‌بندی پروژه‌ها' : 'Filter projects by category'}>
    <button type="button" class="project-filter is-active" data-project-filter="all" aria-pressed="true">{lang === 'fa' ? 'همه' : 'All'}</button>
    {usedCategories.map(category => <button type="button" class="project-filter" data-project-filter={category} aria-pressed="false">{label(categories, category)}</button>)}
  </div>
)}

{projects.length ? (
  <div class={`project-grid ${featuredOnly ? 'project-grid--featured' : ''}`} data-project-grid>
    {projects.map((project: any) => {
      const copy = localizedValue(project.locales, lang);
      const role = project.role?.[lang];
      const articleHref = projectUrl(lang, project);
      return (
        <article class="project-card" data-project-card data-categories={[project.category, ...(project.secondaryCategories || [])].join(' ')}>
          <ProjectVisual category={project.category} lang={lang} compact icon={project.icon} image={publicMediaPath(project.image)} imageAlt={project.imageAlt?.[lang]} />
          <div class="project-card__body">
            <div class="project-card__meta"><span>{label(categories, project.category)}</span><span>{label(maturity, project.maturity)}</span></div>
            <h2><a href={articleHref} class="stretched-link">{copy.title}</a></h2>
            {role && <p class="project-card__role">{role}</p>}
            <p class="project-card__description">{copy.description || copy.summary}</p>
            <ul class="project-tech-list" aria-label={lang === 'fa' ? 'فناوری‌ها' : 'Technologies'}>
              {project.technologies.slice(0, 5).map((technology: string) => { const Icon = technologyIcon(technology); return <li><Icon size={15} strokeWidth={1.8} aria-hidden="true" />{technology}</li>; })}
            </ul>
            <div class="project-card__actions">
              <a class="project-action project-action--primary" href={articleHref}>{lang === 'fa' ? 'خواندن پروژه' : 'Read project'} <span aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>
              {project.caseStudy && <a class="project-action" href={`/${lang}/projects/${project.id}/`}>{lang === 'fa' ? 'خلاصهٔ مطالعهٔ موردی' : 'Case-study summary'} <span aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>}
              {project.repository && <a class="project-action" href={project.repository} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
              {project.externalUrl && <a class="project-action" href={project.externalUrl} target="_blank" rel="noopener noreferrer">{lang === 'fa' ? 'نمایش زنده' : 'Live demo'} <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
) : <EmptyState title={lang === 'fa' ? 'پروژه‌ها' : 'Projects'} description={lang === 'fa' ? 'پروژهٔ عمومی برای نمایش وجود ندارد.' : 'There are no public projects to display.'} />}

{showFilters && <script>
  document.querySelectorAll('[data-project-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-project-filter');
      document.querySelectorAll('[data-project-filter]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
      document.querySelectorAll('[data-project-card]').forEach((card) => { const categories = card.getAttribute('data-categories')?.split(' ') || []; (card as HTMLElement).hidden = filter !== 'all' && !categories.includes(filter || ''); });
    });
  });
</script>}
