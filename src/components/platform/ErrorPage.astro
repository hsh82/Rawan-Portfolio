---
import Layout from '../../layouts/Layout.astro';
import Buttons from '../ui/Buttons.astro';
import { t, type Locale } from '../../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Layout
  lang={lang}
  title={t('errors.notFoundTitle', lang)}
  description={t('errors.notFoundDescription', lang)}
>
  <section class="error-page" aria-labelledby="error-title">
    <div class="error-page-card">
      <p class="error-page-code" aria-hidden="true">404</p>
      <p class="eyebrow">{t('errors.notFoundLabel', lang)}</p>
      <h1 id="error-title">{t('errors.notFoundTitle', lang)}</h1>
      <p class="error-page-description">{t('errors.notFoundDescription', lang)}</p>
      <div class="error-page-actions">
        <Buttons text={t('errors.backHome', lang)} href={`/${lang}/`} size="md" />
        <button class="error-page-back" type="button" id="error-page-back">
          {t('errors.goBack', lang)}
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  const backButton = document.querySelector<HTMLButtonElement>('#error-page-back');
  backButton?.addEventListener('click', () => {
    if (window.history.length > 1) window.history.back();
    else window.location.assign('/');
  });
</script>

<style>
  .error-page {
    display: grid;
    min-height: min(70vh, 46rem);
    place-items: center;
    padding: 5rem 1.5rem;
    background:
      radial-gradient(circle at 50% 18%, rgb(10 132 255 / .12), transparent 32rem),
      linear-gradient(180deg, transparent, rgb(245 248 252 / .72));
  }

  .dark .error-page {
    background:
      radial-gradient(circle at 50% 18%, rgb(10 132 255 / .16), transparent 32rem),
      linear-gradient(180deg, transparent, rgb(13 17 23 / .7));
  }

  .error-page-card {
    width: min(100%, 40rem);
    padding: clamp(2rem, 6vw, 4.5rem);
    border: 1px solid rgb(10 132 255 / .16);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / .9);
    box-shadow: 0 1.5rem 4rem rgb(16 32 57 / .1);
    text-align: center;
  }

  .dark .error-page-card {
    border-color: rgb(125 211 252 / .18);
    background: rgb(19 27 39 / .92);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / .22);
  }

  .error-page-code {
    margin: 0;
    color: #0a84ff;
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 800;
    letter-spacing: -.08em;
    line-height: .9;
  }

  .error-page-card h1 {
    margin: .75rem 0 0;
    color: #102039;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.25;
  }

  .dark .error-page-card h1 { color: #f8fafc; }

  .error-page-description {
    max-width: 34rem;
    margin: 1rem auto 0;
    color: #64748b;
    line-height: 1.8;
  }

  .dark .error-page-description { color: #cbd5e1; }

  .error-page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .75rem;
    margin-top: 2rem;
  }

  .error-page-back {
    min-height: 3rem;
    padding: .75rem 1.5rem;
    border: 1px solid rgb(10 132 255 / .35);
    border-radius: .5rem;
    color: #0a84ff;
    background: transparent;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background-color .2s, color .2s, border-color .2s;
  }

  .error-page-back:hover {
    color: white;
    border-color: #0a84ff;
    background: #0a84ff;
  }

  @media (max-width: 600px) {
    .error-page { padding: 3rem 1rem; }
    .error-page-card { border-radius: 1rem; }
    .error-page-actions > * { width: 100%; }
  }
</style>
