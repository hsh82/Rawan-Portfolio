---
import Layout from '../../layouts/Layout.astro';
import HomeSurface from '../../components/platform/HomeSurface.astro';

import { portfolio } from '../../utils/portfolio-content';

const lang = 'fa' as const;

// Use translated strings from en.json via the t() helper
const pageTitle = portfolio().site.locales.fa.title;
const pageDescription = portfolio().site.locales.fa.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <HomeSurface lang={lang} data={portfolio()} />
</Layout>
