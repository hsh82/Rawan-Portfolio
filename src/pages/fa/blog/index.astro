---
import Layout from '../../../layouts/Layout.astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { published } from '../../../utils/blog';
import { t } from '../../../utils/i18n';
const lang = 'fa';
const articles = await published(lang);
---
<Layout lang={lang} title={t('blog.title', lang)} description={t('blog.intro', lang)}><BlogIndex lang={lang} articles={articles} /></Layout>
